[Unit]
Description=Voice dictation daemon (sunoto Rust pipeline + GTK overlay)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Paths are rewritten by install.sh to the actual checkout.
Environment=SUNOTO_ROOT=__SUNOTO_ROOT__
ExecStart=__SUNOTO_ROOT__/target/release/sunoto-daemon run
Restart=on-failure
RestartSec=3
# The NeMo/Nemotron ASR sidecar dominates memory (~3.6 GiB VRAM, several GiB
# RAM at model load); the daemon itself is small. Sidecars are child
# processes, so one budget covers the whole tree.
MemoryHigh=10G
MemoryMax=14G

[Install]
WantedBy=graphical-session.target
